# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# OpenAI, limits and telemetry settings are REQUIRED: the agent refuses to start a run if one is missing.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_BLUEPRINT=gpt-6-luna
OPENAI_MODEL_DRAFT=gpt-6-luna
OPENAI_MODEL_EVAL=gpt-6-luna
# Token counting before each call (tiktoken encoding; gpt-6 models are not known to tiktoken by name).
# o200k_base is the encoding of OpenAI's recent models; step 6 compares it with the tokens OpenAI reports.
OPENAI_TOKENIZER=o200k_base
# Seconds before one OpenAI request times out (it is then retried up to 2 more times, then the run errors).
OPENAI_TIMEOUT_S=180
# 0 for repeatable output. Set to omit if the model rejects a temperature.
OPENAI_TEMPERATURE=0
# Optional: USD per 1M tokens as JSON {"model": [input, output]}, copied from OpenAI's pricing page.
# Used only to show cost in traces and run reports. A model left out shows "price not set" (never a guess).
# Example form: OPENAI_PRICES={"gpt-6-luna": [<in>, <out>], "<sol model id>": [<in>, <out>]}
OPENAI_PRICES={}

# --- Limits and quality gates (starting values; tuned in build step 6) ----
MAX_FIX_ROUNDS=2
MAX_GAP_ROUNDS=1
MAX_INPUT_TOKENS=200000
MAX_CONCURRENCY=2
FAITHFULNESS_MIN=0.90
RELEVANCE_MIN=0.50

# --- Telemetry (OpenTelemetry -> Phoenix) ---------------------------------
# false = no traces sent anywhere. true = OTEL_EXPORTER_OTLP_ENDPOINT is required.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ipo-agent
# Shown on every trace (e.g. local, render).
DEPLOYMENT_ENVIRONMENT=local
# otlp = also send metrics (local collector/Grafana); none = traces only (Render + Phoenix Cloud).
OTEL_METRICS_EXPORTER=none
# Local Phoenix:  http://localhost:6006
# Phoenix Cloud:  https://app.phoenix.arize.com/s/<your-space> (plus PHOENIX_API_KEY)
OTEL_EXPORTER_OTLP_ENDPOINT=
PHOENIX_API_KEY=
# Keep document and prompt text out of traces (must stay false for anything not public).
OTEL_CAPTURE_CONTENT=false

# --- Storage (optional; defaults to ./data) -------------------------------
# IPO_DATA_DIR=/tmp/ipo/data
# IPO_CACHE_DIR=

# --- App access on Render (used by the agent page, build step 8) ------------
APP_PASSWORD=
